{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "types": ["node"], "noUncheckedIndexedAccess": false
  },
  "include": ["src", "tests"]
}
