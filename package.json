{
  "name": "fabricaclipe",
  "version": "1.0.0",
  "description": "Fábrica de Clipe: escritório 2.5D (Three.js) ligado ao backend por WebSocket",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "demo": "node server/server.js --demo",
    "test": "node --test tests/events.test.mjs tests/flow.test.mjs tests/stats.test.mjs tests/orchestrator.test.ts tests/ffmpeg.test.ts tests/capture.test.ts tests/cutting.test.ts tests/qa-backend.test.ts tests/subtitles.test.ts tests/rendering.test.ts tests/analysis.test.ts tests/ui-media.test.ts tests/integrations.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs --log-level=warning && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs --log-level=warning",
    "desktop": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "build:embed": "node tools/build-embed.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "simple-icons": "^16.38.0",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "main": "dist/main.cjs",
  "productName": "Fábrica de Clipe"
}